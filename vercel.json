{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @capone/web run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next",
      "config": { "rootDirectory": "apps/web" }
    },
    {
      "src": "apps/api/src/vercel-handler.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/src/vercel-handler.ts" }
  ]
}
