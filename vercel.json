{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm -r run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "builds": [
    {
      "src": "apps/api/src/server.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 10 }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/api/src/server.ts" },
    { "src": "/(.*)", "dest": "apps/web/$1" }
  ]
}
